+#[derive(Default)]
+struct V7CoalesceWindow {
+    durable_frontier: u64,
+    deadline: Option<Instant>,
+}
+
+impl V7CoalesceWindow {
+    fn deadline(&mut self, durable_frontier: u64, wait: Duration) -> Instant {
+        if self.durable_frontier != durable_frontier {
+            self.durable_frontier = durable_frontier;
+            self.deadline = None;
+        }
+        // Retaining a preceding FRONTIER can make the next written target
+        // physically ineligible. A retry spends only the original window's
+        // remaining budget, even if more DATA has completed in the meantime.
+        *self.deadline.get_or_insert_with(|| Instant::now() + wait)
+    }
