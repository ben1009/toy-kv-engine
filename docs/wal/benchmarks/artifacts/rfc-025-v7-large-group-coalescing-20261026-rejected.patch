+fn has_only_large_v7_written_groups(inner: &RuntimeInner) -> bool {
+    let (durable, written) = {
+        let state = inner.durability.state.lock();
+        (state.durable_frontier, state.written_frontier)
+    };
+    let admission = inner.admission.lock();
+    v7_prefix_is_large(&admission.v7_prefixes, durable, written)
+}
+
+fn v7_prefix_is_large(
+    prefixes: &BTreeMap<u64, WalV7PrefixMetadata>,
+    durable: u64,
+    written: u64,
+) -> bool {
+    if written <= durable {
+        return false;
+    }
+    let mut last_endpoint = None;
+    for (endpoint, prefix) in prefixes.range((
+        std::ops::Bound::Excluded(durable),
+        std::ops::Bound::Included(written),
+    )) {
+        if !prefix.large_group {
+            return false;
+        }
+        last_endpoint = Some(*endpoint);
+    }
+    // A missing snapshot is conservative: do not skip waiting unless the
+    // whole written wave has known group membership, including its endpoint.
+    last_endpoint == Some(written)
+}
