+/// Optional inline completion publication for runtimes that do not need a
+/// separate completion consumer. Methods run on the I/O worker and must not
+/// wait for I/O, submit work, or acquire a lock held across worker backpressure.
+pub(crate) trait IoWorkerCompletion: Send + 'static {
+    fn group_finished(&self, result: GroupWriteResult);
+    fn worker_stopped(&self);
+}
+
+trait CompletionTarget {
+    fn publish(&self, result: GroupWriteResult) -> bool;
+}
+
+impl CompletionTarget for Sender<GroupWriteResult> {
+    fn publish(&self, result: GroupWriteResult) -> bool {
+        self.send(result).is_ok()
+    }
+}
+
+enum WorkerCompletions {
+    Channel(Sender<GroupWriteResult>),
+    Inline(Box<dyn IoWorkerCompletion>),
+}
+
+impl CompletionTarget for WorkerCompletions {
+    fn publish(&self, result: GroupWriteResult) -> bool {
+        match self {
+            Self::Channel(sender) => sender.publish(result),
+            Self::Inline(handler) => {
+                handler.group_finished(result);
+                true
+            }
+        }
+    }
+}
+
+impl Drop for WorkerCompletions {
+    fn drop(&mut self) {
+        if let Self::Inline(handler) = self {
+            // Also runs on startup failure and unwinding, so the owning
+            // runtime never waits forever for a disappeared worker.
+            handler.worker_stopped();
+        }
+    }
+}
