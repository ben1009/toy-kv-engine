+    struct InlineCompletionProbe {
+        events: std::sync::mpsc::Sender<(thread::ThreadId, Option<GroupWriteResult>)>,
+        panic_after_completion: bool,
+    }
+
+    impl IoWorkerCompletion for InlineCompletionProbe {
+        fn group_finished(&self, result: GroupWriteResult) {
+            self.events
+                .send((thread::current().id(), Some(result)))
+                .expect("observe inline group completion");
+            assert!(!self.panic_after_completion, "injected completion panic");
+        }
+
+        fn worker_stopped(&self) {
+            self.events
+                .send((thread::current().id(), None))
+                .expect("observe worker stopping");
+        }
+    }
+
+    fn check_inline_worker_completion(read_only: bool, panic_after_completion: bool) {
+        let base =
+            Path::new(env!("CARGO_MANIFEST_DIR")).join("../target/wal-opt/inline-completion-tests");
+        std::fs::create_dir_all(&base).expect("create local test directory");
+        let directory = tempfile::tempdir_in(base).expect("create temporary directory");
+        let path = directory.path().join("wal");
+        File::create(&path)
+            .expect("create WAL file")
+            .set_len(4096)
+            .expect("size WAL file");
+        let file = File::options()
+            .read(true)
+            .write(!read_only)
+            .custom_flags(libc::O_DIRECT)
+            .open(&path)
+            .expect("open WAL handle");
+        let (events, observations) = std::sync::mpsc::channel();
+        let worker = match IoWorker::spawn_with_completion_handler(
+            Arc::new(file),
+            Arc::new(ArrayQueue::new(1)),
+            None,
+            InlineCompletionProbe {
+                events,
+                panic_after_completion,
+            },
+        ) {
+            Ok(worker) => worker,
+            Err(error) if io_uring_unavailable(&error) => {
+                eprintln!("skipping test (io_uring unavailable): {error:#}");
+                return;
+            }
+            Err(error) => panic!("failed to start WAL I/O worker: {error:#}"),
+        };
+        let mut buffer = DirectBuf::new(4096);
+        buffer.as_mut_slice().fill(0x53);
+        buffer.set_len(4096);
+        worker
+            .submit_group(
+                WriteGroup::new(0..1, vec![WriteBuffer::new(buffer, 0, 4096)])
+                    .expect("build group"),
+            )
+            .expect("submit group");
+        let (worker_thread, result) = observations
+            .recv_timeout(Duration::from_secs(5))
+            .expect("inline group result");
+        let result = result.expect("group completion precedes worker shutdown");
+        assert_ne!(worker_thread, thread::current().id());
+        assert_eq!(result.tickets, 0..1);
+        assert_eq!(result.error.is_some(), read_only);
+        assert_eq!(worker.slots.state.lock().active_groups, 0);
+        assert!(worker.completions().try_recv().is_err());
+        let closed = worker.close();
+        assert_eq!(closed.is_err(), panic_after_completion);
+        let (stopped_thread, result) = observations
+            .recv_timeout(Duration::from_secs(5))
+            .expect("worker stop notification");
+        assert_eq!(stopped_thread, worker_thread);
+        assert!(result.is_none());
+        assert!(observations.try_recv().is_err());
+        let expected = if read_only { 0 } else { 0x53 };
+        assert!(
+            std::fs::read(path)
+                .expect("read WAL contents")
+                .iter()
+                .all(|&byte| byte == expected)
+        );
+    }
