+
+    #[test]
+    fn canonical_entry_crc_matches_v5_across_block_boundaries() -> Result<()> {
+        for value_len in [0, 1, 15, 16, 47, 48, 63, 64, 127, 128, 4095, 4096, 8193] {
+            let value: Vec<_> = (0..value_len).map(|index| (index % 251) as u8).collect();
+            let mut batch = batch();
+            batch
+                .entries
+                .push(WalEntry::PointDelete { key: b"a".to_vec() });
+            batch.entries.push(WalEntry::Put {
+                key: b"a".to_vec(),
+                value,
+            });
+            let stream = CanonicalWalEntryStream::new(&batch, LIVE_WAL_V5_LIMITS)?;
+            let canonical = canonical_batch(&batch, LIVE_WAL_V5_LIMITS)?;
+            let reference = encode_v5_batch(&canonical, LIVE_WAL_V5_LIMITS)?;
+            let mut output = vec![0xa5; stream.data_len() + 17];
+            let (written, crc) = stream.encode_into(&mut output)?;
+            assert_eq!(written, stream.data_len());
+            assert_eq!(
+                output[..written],
+                reference[WAL_V5_BATCH_HEADER_LEN..WAL_V5_BATCH_HEADER_LEN + written]
+            );
+            assert_eq!(crc.to_be_bytes(), reference[28..32]);
+            assert!(output[written..].iter().all(|byte| *byte == 0xa5));
