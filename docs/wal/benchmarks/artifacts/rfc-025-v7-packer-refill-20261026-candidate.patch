@@ -1758,0 +1766 @@ fn pack_admitted_groups(
+        let expected_ticket = packed.next_ticket;
@@ -1841,0 +1850,34 @@ fn pack_admitted_groups(
+/// Extend a v7 DATA group with one snapshot of admissions that arrived during
+/// its first materialization pass. Membership stays bounded and ordered;
+/// callers frame the returned scratch batches after releasing admission.
+fn take_v7_group_refill(
+    admission: &mut AdmissionState,
+    packed: &mut PackedGroup,
+    v7_batches: &mut Vec<AdmittedBatch>,
+) -> Result<()> {
+    ensure!(packed.v7_layout, "only v7 groups support packer refill");
+    let remaining = PACKER_GROUP_MAX_TICKETS.saturating_sub(packed.writes.len());
+    if remaining == 0 {
+        return Ok(());
+    }
+    let Some(refill) = take_admitted_group(
+        admission,
+        packed.next_ticket,
+        packed.reserved_end,
+        remaining,
+        v7_batches,
+    )?
+    else {
+        return Ok(());
+    };
+    ensure!(
+        refill.v7_layout,
+        "v7 packer refill has an incompatible layout"
+    );
+    packed.next_ticket = refill.next_ticket;
+    packed.reserved_end = refill.reserved_end;
+    packed.frontier_offsets.extend(refill.frontier_offsets);
+    packed.initialize_extents |= refill.initialize_extents;
+    Ok(())
+}
