+            .expect_err("hash failure must poison the runtime");
+        assert!(format!("{error:#}").contains("commit timestamp"));
+        wal.submit_and_commit(acknowledged)?;
+        assert!(runtime.is_poisoned());
+        assert!(
+            wal.put_v7_batch_with_index(&v7_test_batch(3, 16), LIVE_WAL_V5_LIMITS)
