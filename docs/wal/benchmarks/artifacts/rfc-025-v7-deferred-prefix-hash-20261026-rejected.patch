+/// Advance the logical digest only through completed DATA. The single sync
+/// coordinator performs this without holding admission or the packer mutex.
+fn hash_v7_written_prefix(inner: &RuntimeInner, target: u64) -> Result<()> {
+    let mut state = inner.v7_hash_state.lock();
+    let state = state
+        .as_mut()
+        .context("v7 coordinator has no logical hash state")?;
+    if state.next_ticket >= target {
+        return Ok(());
+    }
+    {
+        let mut admission = inner.admission.lock();
+        while admission
+            .v7_pending_hash
+            .front()
+            .is_some_and(|batch| batch.ticket < target)
+        {
+            state.pending.push(
+                admission
+                    .v7_pending_hash
+                    .pop_front()
+                    .expect("front hash batch is present"),
+            );
+        }
+    }
+    let WalV7HashState {
+        next_ticket,
+        prefix,
+        pending,
+    } = state;
+    for batch in pending.drain(..) {
+        ensure!(
+            batch.ticket == *next_ticket,
+            "v7 coordinator logical hash ticket is not contiguous"
+        );
+        ensure!(
+            batch.input.commit_ts > prefix.last_commit_ts,
+            "v7 coordinator commit timestamp does not advance"
+        );
+        prefix
+            .logical_hasher
+            .update(batch.input.logical_batch.as_bytes());
+        prefix.last_commit_ts = batch.input.commit_ts;
+        *next_ticket = next_ticket
+            .checked_add(1)
+            .context("v7 logical hash ticket overflows")?;
+        // The encoded bytes drop before their reservation pin on each iteration.
+    }
+    ensure!(
+        *next_ticket == target,
+        "v7 coordinator has no logical bytes for written prefix"
+    );
+    let mut admission = inner.admission.lock();
+    admission
+        .v7_metadata
+        .as_mut()
+        .context("v7 coordinator has no runtime metadata")?
+        .logical_hasher = prefix.logical_hasher.clone();
+    ensure!(
+        admission
+            .v7_prefixes
+            .insert(target, prefix.clone())
+            .is_none(),
+        "v7 WAL endpoint already has logical prefix state"
+    );
+    Ok(())
+}
