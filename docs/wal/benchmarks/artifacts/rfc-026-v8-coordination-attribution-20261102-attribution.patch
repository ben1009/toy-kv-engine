+//! Temporary, opt-in timed-interval WAL attribution. Scope timings are sampled
+//! and inclusive. Allocation counts cover active-interval Rust allocations and
+//! separately instrumented native aligned buffers.
+
+use std::{cell::{Cell, RefCell}, sync::{Mutex, atomic::{AtomicBool, Ordering}}, time::Instant};
+use serde::Serialize;
+
+pub static ACTIVE: AtomicBool = AtomicBool::new(false);
+const SAMPLE_RATE: u64 = 64;
+const COUNT: usize = 34;
+#[derive(Clone, Copy)]
+#[repr(usize)]
+pub enum Phase {
+    Producer, Preflight, Encode, Frame, DirectAlloc, Admit, Digest, FramesReady,
+    DataComplete, ReserveFrontier, PublishDurable, Snapshot, Coalesce, CoordinatorLock,
+    SubmissionLock, SubmitData, PackData, WorkerSubmit, WorkerCqe, CompletionReceive,
+    CompletionPublish, FrontierEncode, FrontierWrite, FrontierSync, ResourcesRetire,
+    GuardsRetire, V7Materialize, V7SyncCycle, WorkerReceive, MemtablePublish, MvccPublish, V7LogicalHash, FrontierLock, CoordinatorWait,
+}
+const NAMES: [&str; COUNT] = [
+    "producer", "preflight", "encode", "frame", "direct_alloc", "admit", "digest_ready",
+    "frames_ready", "data_complete", "reserve_frontier", "publish_durable", "snapshot",
+    "coalesce", "coordinator_lock_wait", "submission_lock_wait", "submit_data", "pack_data",
+    "worker_submit", "worker_cqe", "completion_receive", "completion_publish", "frontier_encode",
+    "frontier_write", "frontier_sync", "resources_retire", "guards_retire", "v7_materialize",
+    "v7_sync_cycle", "worker_receive", "memtable_publish", "mvcc_publish", "v7_logical_hash", "frontier_lock_wait", "coordinator_wait",
+];
+
+#[derive(Clone, Copy, Default, Serialize)]
+struct Bucket { calls: u64, samples: u64, cpu_ns: u64, wall_ns: u64 }
+#[derive(Clone, Copy, Default, Serialize)]
+struct Usage { user_us: u64, system_us: u64, voluntary: u64, involuntary: u64, minor_faults: u64, major_faults: u64 }
+#[derive(Serialize)]
+struct ThreadStats {
+    tid: u32, name: String, buckets: Vec<Bucket>,
+    first_usage: Usage, last_usage: Usage, allocations: [u64; 8],
+}
+static THREADS: Mutex<Vec<ThreadStats>> = Mutex::new(Vec::new());
+static PROCESS: Mutex<(Usage, Usage)> = Mutex::new((Usage { user_us: 0, system_us: 0, voluntary: 0, involuntary: 0, minor_faults: 0, major_faults: 0 }, Usage { user_us: 0, system_us: 0, voluntary: 0, involuntary: 0, minor_faults: 0, major_faults: 0 }));
+struct LocalStats(Option<ThreadStats>);
+impl Drop for LocalStats {
+    fn drop(&mut self) {
+        if let Some(mut stats) = self.0.take() {
+            stats.allocations = ALLOCATIONS.try_with(Cell::get).unwrap_or_default();
+            THREADS.lock().unwrap().push(stats);
+        }
+    }
+}
+thread_local! {
+    static LOCAL: RefCell<LocalStats> = const { RefCell::new(LocalStats(None)) };
+    static ALLOCATIONS: Cell<[u64; 8]> = const { Cell::new([0; 8]) };
+}
+
+pub fn allocation(event: usize, bytes: usize) {
+    if ACTIVE.load(Ordering::Relaxed) {
+        let _ = ALLOCATIONS.try_with(|cell| {
+            let mut counters = cell.get();
+            counters[event] += 1;
+            counters[event + 1] += bytes as u64;
+            cell.set(counters);
+        });
+    }
+}
+
+fn usage(who: i32) -> Usage {
+    let mut raw = std::mem::MaybeUninit::<libc::rusage>::uninit();
+    // SAFETY: getrusage initializes the supplied struct on success.
+    if unsafe { libc::getrusage(who, raw.as_mut_ptr()) } != 0 { return Usage::default(); }
+    // SAFETY: successful getrusage initialized the value.
+    let raw = unsafe { raw.assume_init() };
+    Usage {
+        user_us: (raw.ru_utime.tv_sec * 1_000_000 + raw.ru_utime.tv_usec) as u64,
+        system_us: (raw.ru_stime.tv_sec * 1_000_000 + raw.ru_stime.tv_usec) as u64,
+        voluntary: raw.ru_nvcsw as u64, involuntary: raw.ru_nivcsw as u64,
+        minor_faults: raw.ru_minflt as u64, major_faults: raw.ru_majflt as u64,
+    }
+}
+
+pub struct Scope { phase: usize, started: Instant, cpu: u64 }
+pub fn scope(phase: Phase) -> Option<Scope> {
+    if !ACTIVE.load(Ordering::Relaxed) { return None; }
+    let sampled = LOCAL.with(|cell| {
+        let mut local = cell.borrow_mut();
+        let stats = local.0.get_or_insert_with(|| ThreadStats {
+            // SAFETY: gettid has no memory arguments.
+            tid: unsafe { libc::syscall(libc::SYS_gettid) as u32 },
+            name: std::thread::current().name().unwrap_or("producer").to_owned(),
+            buckets: vec![Bucket::default(); COUNT], first_usage: usage(libc::RUSAGE_THREAD),
+            last_usage: Usage::default(), allocations: [0; 8],
+        });
+        let b = &mut stats.buckets[phase as usize]; b.calls += 1;
+        b.calls % SAMPLE_RATE == 1
+    });
+    sampled.then(|| Scope { phase: phase as usize, started: Instant::now(), cpu: crate::wal::v8::digest::thread_cpu_time_ns() })
+}
+impl Drop for Scope {
+    fn drop(&mut self) {
+        let cpu = crate::wal::v8::digest::thread_cpu_time_ns().saturating_sub(self.cpu);
+        let wall = self.started.elapsed().as_nanos() as u64;
+        if !ACTIVE.load(Ordering::Relaxed) { return; }
+        LOCAL.with(|cell| {
+            if let Some(stats) = cell.borrow_mut().0.as_mut() {
+                let b = &mut stats.buckets[self.phase];
+                b.samples += 1; b.cpu_ns += cpu; b.wall_ns += wall;
+                stats.last_usage = usage(libc::RUSAGE_THREAD);
+            }
+        });
+    }
+}
+
+pub fn begin() {
+    if std::env::var_os("TOYKV_WAL_ATTRIBUTION").is_none() { return; }
+    *THREADS.lock().unwrap() = Vec::with_capacity(128);
+    PROCESS.lock().unwrap().0 = usage(libc::RUSAGE_SELF);
+    ACTIVE.store(true, Ordering::Release);
+}
+pub fn producer_finished() {
+    if ACTIVE.load(Ordering::Relaxed) {
+        LOCAL.with(|cell| { if let Some(stats) = cell.borrow_mut().0.as_mut() { stats.last_usage = usage(libc::RUSAGE_THREAD); } });
+    }
+}
+pub fn end() {
+    if ACTIVE.swap(false, Ordering::AcqRel) { PROCESS.lock().unwrap().1 = usage(libc::RUSAGE_SELF); }
+}
+pub fn finish() -> anyhow::Result<()> {
+    let Some(path) = std::env::var_os("TOYKV_WAL_ATTRIBUTION") else { return Ok(()); };
+    LOCAL.with(|cell| { cell.borrow_mut().0.take().map(|s| drop(LocalStats(Some(s)))); });
+    let threads = THREADS.lock().unwrap();
+    let process = PROCESS.lock().unwrap();
+    serde_json::to_writer_pretty(std::fs::File::create(path)?, &serde_json::json!({
+        "sample_rate": SAMPLE_RATE, "scopes_are_inclusive": true,
+        "allocation_fields": ["rust_alloc_calls", "rust_alloc_bytes", "rust_free_calls", "rust_free_bytes", "native_alloc_calls", "native_alloc_bytes", "native_free_calls", "native_free_bytes"],
+        "phase_names": &NAMES[..], "process_before": process.0, "process_after": process.1, "threads": *threads,
+    }))?;
+    Ok(())
+}
