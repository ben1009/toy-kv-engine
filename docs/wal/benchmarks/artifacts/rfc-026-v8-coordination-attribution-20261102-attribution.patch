+fn perf_timed_control(command: &str) -> Result<()> {
+    use std::io::{BufRead, Write};
+    let Some(directory) = std::env::var_os("KV_PERF_CONTROL_DIR") else { return Ok(()) };
+    let directory = std::path::Path::new(&directory);
+    let mut control = std::fs::OpenOptions::new().write(true).open(directory.join("control"))?;
+    let ack = std::fs::OpenOptions::new().read(true).write(true).open(directory.join("ack"))?;
+    writeln!(control, "{command}")?;
+    let mut response = String::new();
+    std::io::BufReader::new(ack).read_line(&mut response)?;
+    Ok(())
+}
