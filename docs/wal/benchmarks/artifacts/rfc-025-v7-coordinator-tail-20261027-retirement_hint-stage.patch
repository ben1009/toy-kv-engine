+// Temporary diagnostic only. Buffers are local to one worker/coordinator and
+// are emitted at thread shutdown, outside the measured write interval.
+pub(crate) struct WalStageTrace {
+    path: std::path::PathBuf,
+    events: Vec<[u64; 7]>,
+}
+
+impl WalStageTrace {
+    pub(crate) fn new(role: &str) -> Option<Self> {
+        let path = std::env::var_os("KV_WAL_STAGE_TRACE")?;
+        // SAFETY: gettid has no arguments and returns this live thread's ID.
+        let tid = unsafe { libc::syscall(libc::SYS_gettid) };
+        Some(Self {
+            path: std::path::PathBuf::from(format!(
+                "{}.{}.{}.csv",
+                std::path::Path::new(&path).display(),
+                role,
+                tid
+            )),
+            events: Vec::with_capacity(32768),
+        })
+    }
+
+    pub(crate) fn push(&mut self, fields: [u64; 6]) {
+        let mut time = std::mem::MaybeUninit::<libc::timespec>::uninit();
+        // SAFETY: CLOCK_MONOTONIC initializes the writable timespec on success.
+        assert_eq!(
+            unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, time.as_mut_ptr()) },
+            0
+        );
+        // SAFETY: the call above succeeded.
+        let time = unsafe { time.assume_init() };
+        self.events.push([
+            fields[0],
+            fields[1],
+            fields[2],
+            fields[3],
+            fields[4],
+            fields[5],
+            time.tv_sec as u64 * 1_000_000_000 + time.tv_nsec as u64,
+        ]);
+    }
+}
+
+impl Drop for WalStageTrace {
+    fn drop(&mut self) {
+        use std::io::Write;
+        if self.events.is_empty() {
+            return;
+        }
+        let result = (|| -> std::io::Result<()> {
+            let file = std::fs::OpenOptions::new()
+                .write(true)
+                .create_new(true)
+                .open(&self.path)?;
+            let mut output = std::io::BufWriter::new(file);
+            writeln!(
+                output,
+                "event,request,ticket,group_end,offset,length,time_ns"
+            )?;
+            for r in &self.events {
+                writeln!(
+                    output,
+                    "{},{},{},{},{},{},{}",
+                    r[0], r[1], r[2], r[3], r[4], r[5], r[6]
+                )?;
+            }
+            output.flush()
+        })();
+        if let Err(error) = result {
+            eprintln!("stage trace emission failed: {error}");
+        }
+    }
+}
