+    #[test]
+    fn v7_worker_group_geometry_distinguishes_large_and_mixed_logical_batches() -> anyhow::Result<()>
+    {
+        use crate::wal::v7::{
+            install::recover_and_install_active, recovery::WalV7RecoveryAuthority,
+        };
+
+        for mixed in [false, true] {
+            let directory = tempfile::tempdir()?;
+            let path = directory.path().join("group-membership.wal");
+            let Some(V7RuntimeTestWal { wal, owner, anchor }) =
+                live_v7_test_wal(&path, super::MAX_WAL_FILE_SIZE, v7_test_resource_limits())?
+            else {
+                return Ok(());
+            };
+            #[cfg(feature = "bench")]
+            let profile = {
+                let profile = Arc::new(crate::mem_table::WriteProfile::default());
+                wal.set_write_profile(Arc::clone(&profile));
+                profile
+            };
+            let mut first = v7_test_batch(1, 65_535);
+            if mixed {
+                // The large batch plus the tiny one still average above
+                // 64 KiB. Only the minimum proves this is a mixed group.
+                first.entries.push(WalEntry::Put {
+                    key: b"second-large-value".to_vec(),
+                    value: vec![0x5A; 65_535],
+                });
+            }
+            let batches = [first, v7_test_batch(2, if mixed { 10 } else { 65_535 })];
+            let runtime = wal.parallel_runtime.as_ref().unwrap();
+            let packer = runtime.inner.packer_state.lock();
+            for batch in &batches {
+                wal.put_v7_batch_with_index(batch, LIVE_WAL_V5_LIMITS)?;
+            }
+            assert_eq!(runtime.inner.admission.lock().queue.len(), 2);
+            drop(packer);
+            wal.submit_and_commit(1)?;
+            {
+                let state = runtime.inner.durability.state.lock();
+                assert_eq!((state.written_frontier, state.durable_frontier), (2, 2));
+                assert_eq!(state.large_batch_wave, !mixed);
+            }
+            #[cfg(feature = "bench")]
+            {
+                assert_eq!(profile.wal_commit_groups.load(super::Ordering::Acquire), 1);
+                assert_eq!(profile.wal_commit_buffers.load(super::Ordering::Acquire), 2);
+            }
+            wal.close()?;
+            assert_eq!(owner.snapshot().buffer_memory_bytes, 0);
+            drop(wal);
+            let recovered = recover_and_install_active(
+                &path,
+                WalV7RecoveryAuthority::Active {
+                    predecessor: crate::pitr::ChainAnchor::Genesis {
+                        archive_epoch_id: crate::pitr::ArchiveEpochId(anchor.archive_epoch_id),
+                    },
+                    durable_anchors: vec![anchor],
+                },
+            )?;
+            assert_eq!(recovered.installed.batches, batches);
+        }
