+    #[test]
+    fn async_v7_extent_sync_priority_defers_chunks_but_allows_demand_and_recovery()
+    -> anyhow::Result<()> {
+        use std::os::unix::fs::FileExt;
+
+        use crate::wal::v7::{
+            install::recover_and_install_active, recovery::WalV7RecoveryAuthority,
+        };
+
+        let directory = async_extent_test_directory()?;
+        let path = directory.path().join("sync-priority.wal");
+        let Some(V7RuntimeTestWal { wal, owner, anchor }) =
+            live_v7_test_wal(&path, super::MAX_WAL_FILE_SIZE, v7_test_resource_limits())?
+        else {
+            return Ok(());
+        };
+        let concurrent = owner.reserve_batch(256)?;
+        let runtime = wal.parallel_runtime.as_ref().unwrap();
+        let Some((entered, resume)) = pause_async_extent(runtime) else {
+            eprintln!("skipping async extent test (ext filesystem unavailable)");
+            return Ok(());
+        };
+        let control = Arc::clone(runtime.inner.async_v7_extents.as_ref().unwrap());
+        let mut batches = vec![v7_test_batch(1, 16)];
+        let ticket = wal
+            .put_v7_batch_with_index(&batches[0], LIVE_WAL_V5_LIMITS)?
+            .0;
+        wal.submit_and_commit(ticket)?;
+        entered.recv_timeout(std::time::Duration::from_secs(5))?;
+        let first_priority = control.prioritize_sync(&runtime.inner.prepared_file_end);
+        let second_priority = control.prioritize_sync(&runtime.inner.prepared_file_end);
+        let sentinel = 3 * super::EXTENT_INITIALIZATION_CHUNK as u64;
+        let canary = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(&path)?;
+        canary.write_all_at(b"unused", sentinel)?;
+        resume.send(())?;
+        wait_for_extent_state(|| control.deferred_requests.load(super::Ordering::Acquire) > 0);
+        assert_eq!(
+            runtime
+                .inner
+                .prepared_file_end
+                .load(super::Ordering::Acquire),
+            super::EXTENT_INITIALIZATION_CHUNK as u64
+        );
+
+        // Real acknowledged writes cross the ready prefix while optional
+        // preparation is deferred. Demand must never wait for this hint.
+        for ts in 2..=5 {
+            let batch = v7_test_batch(ts, 32 * 1024);
+            let ticket = wal.put_v7_batch_with_index(&batch, LIVE_WAL_V5_LIMITS)?.0;
+            wal.submit_and_commit(ticket)?;
+            batches.push(batch);
+        }
+        let ready = runtime
+            .inner
+            .prepared_file_end
+            .load(super::Ordering::Acquire);
+        assert!(ready > super::EXTENT_INITIALIZATION_CHUNK as u64);
+        assert!(ready <= sentinel);
+        let mut unused = [0; 6];
+        canary.read_exact_at(&mut unused, sentinel)?;
+        assert_eq!(&unused, b"unused");
+        let accepted_end = runtime.logical_length() as usize;
+        let accepted = std::fs::read(&path)?[..accepted_end].to_vec();
+        drop(first_priority);
+        assert_eq!(*control.sync_priority.lock(), 1);
+        drop(second_priority);
+        // No new producer is needed to resume the pending allocated suffix.
+        wait_for_extent_state(|| {
+            runtime
+                .inner
+                .prepared_file_end
+                .load(super::Ordering::Acquire)
+                == super::PREALLOC_BLOCK
+        });
+        canary.read_exact_at(&mut unused, sentinel)?;
+        assert_eq!(unused, [0; 6]);
+        assert_eq!(&std::fs::read(&path)?[..accepted_end], accepted);
+        drop(concurrent);
+        wal.close()?;
+        assert_eq!(owner.snapshot().buffer_memory_bytes, 0);
+        drop(wal);
+        let recovered = recover_and_install_active(
+            &path,
+            WalV7RecoveryAuthority::Active {
+                predecessor: crate::pitr::ChainAnchor::Genesis {
+                    archive_epoch_id: crate::pitr::ArchiveEpochId(anchor.archive_epoch_id),
+                },
+                durable_anchors: vec![anchor],
+            },
+        )?;
+        assert_eq!(recovered.installed.batches, batches);
+        Ok(())
+    }
