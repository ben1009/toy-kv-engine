+/// Defer new optional chunks while the coordinator writes and syncs its
+/// certificate. Already selected I/O may finish; demand never waits on this
+/// hint. Resume a pending target on every exit, including error or unwind.
+struct V7SyncExtentPriority<'a> {
+    control: &'a AsyncV7ExtentControl,
+    prepared_end: &'a AtomicU64,
+}
+
+impl Drop for V7SyncExtentPriority<'_> {
+    fn drop(&mut self) {
+        let resume = {
+            let mut active = self.control.sync_priority.lock();
+            *active -= 1;
+            *active == 0
+        };
+        let target = self.control.target.load(Ordering::Acquire);
+        if resume && target > self.prepared_end.load(Ordering::Acquire) {
+            self.control.request(target);
+        }
+    }
+}
