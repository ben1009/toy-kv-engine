+    #[test]
+    fn group_minimum_write_size_survives_frontier_gaps_and_out_of_order_cqes() {
+        for (first_len, second_len, short_first) in [
+            (64 * 1024, 128 * 1024, false),
+            (128 * 1024, 4096, false),
+            (64 * 1024, 128 * 1024, true),
+        ] {
+            let drops = Arc::new(AtomicUsize::new(0));
+            let gap = first_len as u64;
+            let second_offset = gap + DIRECT_IO_ALIGNMENT as u64;
+            let group = WriteGroup::new_with_frontiers(
+                0..2,
+                vec![
+                    WriteBuffer::new(
+                        DropProbe::new(first_len + 4096, Arc::clone(&drops)),
+                        0,
+                        first_len,
+                    ),
+                    WriteBuffer::new(
+                        DropProbe::new(second_len, Arc::clone(&drops)),
+                        second_offset,
+                        second_len,
+                    ),
+                ],
+                0..second_offset + second_len as u64,
+                &[gap],
+            )
+            .expect("DATA writes span one separately owned FRONTIER frame");
+            let mut core = WorkerCore::new();
+            core.enqueue(group).expect("enqueue DATA group");
+            let failure_snapshot = core.failed_group_results("snapshot before terminal CQEs");
+            assert_eq!(
+                failure_snapshot[0].min_write_bytes,
+                first_len.min(second_len) as u64
+            );
+
+            let requests = submitted_ids(&mut core, 256);
+            assert_eq!(requests.len(), 2);
+            for event in core.complete_write(requests[1], second_len as i32).unwrap() {
+                match event {
+                    WorkerEvent::BufferRetired(buffer) => drop(buffer),
+                    WorkerEvent::GroupFinished(_) => panic!("the first DATA write is incomplete"),
+                }
+            }
+            let first_result = first_len - if short_first { 4096 } else { 0 };
+            let result = take_group_result(
+                core.complete_write(requests[0], first_result as i32)
+                    .unwrap(),
+            );
+            assert_eq!(result.min_write_bytes, first_len.min(second_len) as u64);
+            assert_eq!(result.write_bytes, (first_len + second_len) as u64);
+            assert_eq!(result.write_count, 2);
+            assert_eq!(result.error.is_some(), short_first);
+            assert!(core.is_idle());
+            assert_eq!(drops.load(Ordering::Acquire), 2);
+        }
+    }
