+    fn close(&mut self) -> Result<()> {
+        self.control.stopping.store(true, Ordering::Release);
+        self.control.requests.lock().take();
+        if let Some(join) = self.join.take() {
+            join.join()
+                .map_err(|_| anyhow!("v7 extent initializer panicked"))??;
+        }
+        Ok(())
+    }
