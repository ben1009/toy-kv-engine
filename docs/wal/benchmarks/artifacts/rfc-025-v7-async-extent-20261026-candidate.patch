+                if result.is_err() {
+                    worker_control.fail("v7 extent initializer panicked".to_owned());
+                    bail!("v7 extent initializer panicked");
+                }
+                Ok(())
+            })
+            .context("failed to spawn v7 extent initializer")?;
+        Ok(Self {
+            control,
+            join: Some(join),
+        })
+    }
