+//! Borrow point-batch inputs until the admitted producer encodes them.
+
+use anyhow::{Context, Result, ensure};
+use bytes::Bytes;
+
+use crate::{mvcc::BatchEntryKind, pitr::WalV5Limits};
+
+type PointEntry = (Bytes, Bytes, BatchEntryKind);
+const OBSERVER_CHUNK_BYTES: usize = 64 * 1024;
+
+pub(super) struct WalV8PointStream<'a> {
+    entries: &'a [PointEntry],
+    retained: Vec<usize>,
+    data_len: usize,
+    entry_count: u32,
+}
+
+impl<'a> WalV8PointStream<'a> {
+    pub(super) fn preparation_buffer_bytes(
+        entries: &[PointEntry],
+        limits: WalV5Limits,
+    ) -> Result<u64> {
+        let limits = limits.validate()?;
+        ensure!(!entries.is_empty(), "v8 batch must contain an entry");
+        ensure!(
+            entries.len() <= limits.max_input_entry_count && entries.len() <= u32::MAX as usize,
+            "v8 input entry count exceeds configured limit"
+        );
+        let index_count = if entries.len() > 1 { entries.len() } else { 0 };
+        let bytes = index_count
+            .checked_mul(std::mem::size_of::<usize>())
+            .context("v8 point index size overflows")?;
+        u64::try_from(bytes).context("v8 point index size exceeds u64")
+    }
+
+    pub(super) fn new(entries: &'a [PointEntry], limits: WalV5Limits) -> Result<Self> {
+        Self::preparation_buffer_bytes(entries, limits)?;
+        let mut retained = Vec::new();
+        if entries.len() > 1 {
+            retained
+                .try_reserve_exact(entries.len())
+                .context("reserve v8 point index")?;
+            retained.extend(0..entries.len());
+            // Highest input index first for each key, then retain that final
+            // operation and restore the surviving operations' input order.
+            retained.sort_unstable_by(|&left, &right| {
+                entries[left]
+                    .0
+                    .cmp(&entries[right].0)
+                    .then_with(|| right.cmp(&left))
+            });
+            retained.dedup_by(|right, left| entries[*right].0 == entries[*left].0);
+            retained.sort_unstable();
+        }
+        let entry_count = if retained.is_empty() {
+            entries.len()
+        } else {
+            retained.len()
+        };
+        ensure!(
+            entry_count <= limits.max_entry_count,
+            "v8 entry count exceeds configured limit"
+        );
+        let mut stream = Self {
+            entries,
+            retained,
+            data_len: 0,
+            entry_count: u32::try_from(entry_count)?,
+        };
+        let mut data_len = 0_usize;
+        for (key, value, kind) in stream.entries() {
+            ensure!(
+                key.len() <= limits.max_key_bytes,
+                "v8 key exceeds configured limit"
+            );
+            let len = if matches!(kind, BatchEntryKind::Delete) {
+                10_usize.checked_add(key.len())
+            } else {
+                let value_len = value
+                    .len()
+                    .checked_add(usize::from(matches!(kind, BatchEntryKind::PutRaw)))
+                    .context("v8 value length overflows")?;
+                ensure!(
+                    value_len <= limits.max_value_bytes,
+                    "v8 value exceeds configured limit"
+                );
+                14_usize
+                    .checked_add(key.len())
+                    .and_then(|len| len.checked_add(value_len))
+            }
+            .context("v8 entry size overflows")?;
+            data_len = data_len
+                .checked_add(len)
+                .context("v8 batch size overflows")?;
+            ensure!(
+                data_len <= limits.max_batch_data_bytes,
+                "v8 batch data exceeds configured limit"
+            );
+        }
+        stream.data_len = data_len;
+        Ok(stream)
+    }
+
+    fn entries(&self) -> impl Iterator<Item = &PointEntry> {
+        (0..self.entry_count as usize)
+            .map(|index| &self.entries[self.retained.get(index).copied().unwrap_or(index)])
+    }
+
+    pub(super) fn data_len(&self) -> usize {
+        self.data_len
+    }
+
+    pub(super) fn entry_count(&self) -> u32 {
+        self.entry_count
+    }
+
+    pub(super) fn encode_into_with_observer<F>(
+        &self,
+        dst: &mut [u8],
+        mut observe: F,
+    ) -> Result<(usize, u32)>
+    where
+        F: FnMut(&[u8]) -> Result<()>,
+    {
+        ensure!(
+            dst.len() >= self.data_len,
+            "v8 point entry output buffer is too small"
+        );
+        let mut crc = crc32fast::Hasher::new();
+        let mut pos = 0;
+        let mut observed = 0;
+        for (key, value, kind) in self.entries() {
+            let put = !matches!(kind, BatchEntryKind::Delete);
+            let raw = matches!(kind, BatchEntryKind::PutRaw);
+            let value_len = value.len() + usize::from(raw);
+            let payload_len = if put {
+                8 + key.len() + value_len
+            } else {
+                4 + key.len()
+            };
+            let mut header = [0; 6];
+            header[0] = if put { 1 } else { 2 };
+            header[2..].copy_from_slice(&u32::try_from(payload_len)?.to_be_bytes());
+            for bytes in [
+                &header[..],
+                &u32::try_from(key.len())?.to_be_bytes(),
+                &key[..],
+            ] {
+                emit(dst, &mut pos, &mut crc, bytes);
+            }
+            if put {
+                emit(
+                    dst,
+                    &mut pos,
+                    &mut crc,
+                    &u32::try_from(value_len)?.to_be_bytes(),
+                );
+                if raw {
+                    emit(
+                        dst,
+                        &mut pos,
+                        &mut crc,
+                        &[crate::vlog::KvKind::Inline as u8],
+                    );
+                }
+                emit(dst, &mut pos, &mut crc, value);
+            }
+            if pos - observed >= OBSERVER_CHUNK_BYTES {
+                observe(&dst[observed..pos])?;
+                observed = pos;
+            }
+        }
+        if observed < pos {
+            observe(&dst[observed..pos])?;
+        }
+        ensure!(
+            pos == self.data_len,
+            "v8 point entry stream length changed while encoding"
+        );
+        Ok((pos, crc.finalize()))
+    }
+}
+
+fn emit(dst: &mut [u8], pos: &mut usize, crc: &mut crc32fast::Hasher, bytes: &[u8]) {
+    dst[*pos..*pos + bytes.len()].copy_from_slice(bytes);
+    crc.update(bytes);
+    *pos += bytes.len();
+}
