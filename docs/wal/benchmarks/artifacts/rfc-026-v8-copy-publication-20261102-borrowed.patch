+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::pitr::{CanonicalWalEntryStream, RecordedAt, WalBatch, WalEntry};
+
+    pub(super) fn owned(entries: &[PointEntry]) -> WalBatch {
+        WalBatch {
+            commit_ts: 17,
+            recorded_at: RecordedAt { secs: -2, nanos: 7 },
+            entries: entries
+                .iter()
+                .map(|(key, value, kind)| match kind {
+                    BatchEntryKind::Delete => WalEntry::PointDelete { key: key.to_vec() },
+                    BatchEntryKind::PutPrefixed => WalEntry::Put {
+                        key: key.to_vec(),
+                        value: value.to_vec(),
+                    },
+                    BatchEntryKind::PutRaw => {
+                        let mut bytes = vec![crate::vlog::KvKind::Inline as u8];
+                        bytes.extend_from_slice(value);
+                        WalEntry::Put {
+                            key: key.to_vec(),
+                            value: bytes,
+                        }
+                    }
+                })
+                .collect(),
+        }
+    }
+
+    #[test]
+    fn borrowed_point_stream_matches_owned_codec_with_duplicate_and_raw_points() -> Result<()> {
+        let limits = crate::pitr::LIVE_WAL_V5_LIMITS;
+        let pool = [
+            (
+                Bytes::from_static(b"a"),
+                Bytes::from_static(b""),
+                BatchEntryKind::PutRaw,
+            ),
+            (
+                Bytes::from_static(b"b"),
+                Bytes::from_static(b"\x01b"),
+                BatchEntryKind::PutPrefixed,
+            ),
+            (
+                Bytes::from_static(b"a"),
+                Bytes::from_static(b"ignored"),
+                BatchEntryKind::Delete,
+            ),
+            (
+                Bytes::from_static(b"b"),
+                Bytes::from_static(b"\x02"),
+                BatchEntryKind::PutRaw,
+            ),
+        ];
+        for mut pattern in 0..256 {
+            let mut entries = Vec::new();
+            for _ in 0..4 {
+                entries.push(pool[pattern % pool.len()].clone());
+                pattern /= pool.len();
+            }
+            let batch = owned(&entries);
+            let expected = CanonicalWalEntryStream::new(&batch, limits)?;
+            let stream = WalV8PointStream::new(&entries, limits)?;
+            assert_eq!(stream.entry_count(), expected.entry_count());
+            let mut bytes = vec![0; stream.data_len()];
+            let mut reference = vec![0; expected.data_len()];
+            let expected_crc = expected.encode_into(&mut reference)?.1;
+            let mut observed = Vec::new();
+            let (_, crc) = stream.encode_into_with_observer(&mut bytes, |range| {
+                observed.extend_from_slice(range);
+                Ok(())
+            })?;
+            assert_eq!(bytes, reference);
+            assert_eq!(observed, reference);
+            assert_eq!(crc, expected_crc);
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn borrowed_point_limits_apply_after_dedup_and_count_raw_value_prefix() -> Result<()> {
+        let limits = WalV5Limits {
+            max_input_entry_count: 4,
+            max_entry_count: 1,
+            max_batch_data_bytes: 64,
+            max_key_bytes: 1,
+            max_value_bytes: 2,
+        };
+        let mut entries = vec![
+            (
+                Bytes::from_static(b"a"),
+                Bytes::from_static(b"too long"),
+                BatchEntryKind::PutRaw,
+            ),
+            (
+                Bytes::from_static(b"a"),
+                Bytes::from_static(b"x"),
+                BatchEntryKind::PutRaw,
+            ),
+        ];
+        let stream = WalV8PointStream::new(&entries, limits)?;
+        assert_eq!(stream.entry_count(), 1);
+        let mut dst = vec![0xa5; stream.data_len() - 1];
+        assert!(
+            stream
+                .encode_into_with_observer(&mut dst, |_| Ok(()))
+                .is_err()
+        );
+        assert!(dst.iter().all(|&byte| byte == 0xa5));
+        entries[1].1 = Bytes::from_static(b"xx");
+        assert!(WalV8PointStream::new(&entries, limits).is_err());
+        entries[1].2 = BatchEntryKind::Delete;
+        assert!(WalV8PointStream::new(&entries, limits).is_ok());
+        entries[1].0 = Bytes::from_static(b"b");
+        assert!(WalV8PointStream::new(&entries, limits).is_err());
+        assert!(WalV8PointStream::new(&[], limits).is_err());
+        assert!(
+            WalV8PointStream::preparation_buffer_bytes(
+                &entries,
+                WalV5Limits {
+                    max_input_entry_count: 1,
+                    ..limits
+                }
+            )
+            .is_err()
+        );
+        Ok(())
+    }
+}
