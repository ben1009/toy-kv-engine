+#![cfg_attr(feature = "mimalloc-allocator", feature(cfg_sanitize))]
+
+/// Optional process-wide Rust allocator for controlled allocator comparisons.
+#[cfg(feature = "mimalloc-allocator")]
+// Sanitizers need the System allocator so their allocation tracking stays active.
+#[cfg(not(any(sanitize = "address", sanitize = "leak")))]
+#[global_allocator]
+static GLOBAL_ALLOCATOR: mimalloc::MiMalloc = mimalloc::MiMalloc;
