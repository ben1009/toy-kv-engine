+#[cfg(test)]
+mod direct_buffer_tests {
+    use super::DirectBuf;
+
+    #[test]
+    fn aligned_buffers_preserve_contents_and_cross_thread_ownership() {
+        for requested in [0, 1, 4096, 4097, 65536, 1_048_576] {
+            let mut buffer = DirectBuf::new(requested);
+            let capacity = buffer.cap();
+            assert!(capacity >= requested.max(4096));
+            assert!(capacity.is_multiple_of(4096));
+            assert_eq!(buffer.as_ptr() as usize % 4096, 0);
+            buffer.zero_range(0, capacity);
+            buffer.write_at(0, b"aligned");
+            buffer.write_at(capacity - 4, b"tail");
+            buffer.set_len(capacity);
+
+            std::thread::spawn(move || {
+                assert_eq!(buffer.len(), capacity);
+                assert_eq!(&buffer.initialized_slice(0, capacity)[..7], b"aligned");
+                assert_eq!(buffer.initialized_slice(capacity - 4, capacity), b"tail");
+                assert!(
+                    buffer
+                        .initialized_slice(7, capacity - 4)
+                        .iter()
+                        .all(|b| *b == 0)
+                );
+                // Dropping on this thread exercises the selected backend's
+                // ownership transfer independently of producer-local frees.
+                drop(buffer);
+            })
+            .join()
+            .expect("aligned buffer consumer completes");
+        }
