+++ b/kv-engine/src/wal.rs
@@ -126,2 +126,3 @@ pub enum WalIoMode {
-/// If the pool is full, the buffer is dropped (freed) — this is safe because
-/// `Drop` calls `libc::free` on the `posix_memalign` allocation.
+/// If the pool is full, the buffer is dropped using the matching allocation
+/// backend. The optional mimalloc configuration routes aligned allocations
+/// through Rust's global allocator; the default uses libc.
@@ -144,10 +145,22 @@ impl DirectBuf {
-        let mut ptr: *mut libc::c_void = std::ptr::null_mut();
-        let ret = unsafe { libc::posix_memalign(&mut ptr, 4096, cap) };
-        // posix_memalign failure is OOM — recovery is impossible at this point.
-        assert_eq!(ret, 0, "posix_memalign failed (OOM)");
-
-        Self {
-            ptr: ptr as *mut u8,
-            len: 0,
-            cap,
-        }
+        #[cfg(feature = "mimalloc-allocator")]
+        let ptr = {
+            let layout = std::alloc::Layout::from_size_align(cap, 4096)
+                .expect("DirectBuf capacity has a valid aligned allocation layout");
+            // SAFETY: capacity is nonzero and the validated layout retains
+            // the 4096-byte alignment required by every direct-I/O caller.
+            let ptr = unsafe { std::alloc::alloc(layout) };
+            if ptr.is_null() {
+                std::alloc::handle_alloc_error(layout);
+            }
+            ptr
+        };
+        #[cfg(not(feature = "mimalloc-allocator"))]
+        let ptr = {
+            let mut ptr: *mut libc::c_void = std::ptr::null_mut();
+            let ret = unsafe { libc::posix_memalign(&mut ptr, 4096, cap) };
+            // posix_memalign failure is OOM — recovery is impossible at this point.
+            assert_eq!(ret, 0, "posix_memalign failed (OOM)");
+            ptr.cast::<u8>()
+        };
+
+        Self { ptr, len: 0, cap }
@@ -178 +191 @@ impl DirectBuf {
-    /// `posix_memalign` is uninitialised, and a recycled buffer's only
+    /// either allocation backend is uninitialised, and a recycled buffer's only
@@ -239 +252,49 @@ impl Drop for DirectBuf {
-        unsafe { libc::free(self.ptr as *mut libc::c_void) };
+        #[cfg(feature = "mimalloc-allocator")]
+        {
+            let layout = std::alloc::Layout::from_size_align(self.cap, 4096)
+                .expect("DirectBuf allocation layout was validated at construction");
+            // SAFETY: this allocation was created with Rust's global
+            // allocator and the exact same capacity and alignment.
+            unsafe { std::alloc::dealloc(self.ptr, layout) };
+        }
+        #[cfg(not(feature = "mimalloc-allocator"))]
+        unsafe {
+            libc::free(self.ptr as *mut libc::c_void)
+        };
+    }
+}
