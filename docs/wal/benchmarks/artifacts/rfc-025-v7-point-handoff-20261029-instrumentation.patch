diff --git a/kv-engine/src/wal.rs b/kv-engine/src/wal.rs
index 71b32c84..bbe78cbf 100644
--- a/kv-engine/src/wal.rs
+++ b/kv-engine/src/wal.rs
@@ -43,0 +44,76 @@ pub(crate) use parallel_runtime::WalV7PreparedBatch;
+// Temporary bounded diagnostic, removed before any scored comparison.
+struct PointTrace {
+    path: std::path::PathBuf,
+    state: Mutex<(Vec<[u64; 6]>, u64)>,
+}
+static POINT_TRACE: std::sync::OnceLock<Option<PointTrace>> = std::sync::OnceLock::new();
+
+fn point_trace() -> Option<&'static PointTrace> {
+    POINT_TRACE
+        .get_or_init(|| {
+            std::env::var_os("KV_WAL_POINT_TRACE").map(|path| PointTrace {
+                path: path.into(),
+                state: Mutex::new((Vec::with_capacity(1_000_000), 0)),
+            })
+        })
+        .as_ref()
+}
+
+#[doc(hidden)]
+pub fn point_trace_enabled() -> bool {
+    point_trace().is_some()
+}
+
+#[doc(hidden)]
+pub fn trace_point_event(event: u64, subject: u64, arg1: u64, arg2: u64) {
+    let trace = point_trace();
+    let Some(trace) = trace else {
+        return;
+    };
+    thread_local! {
+        static TRACE_TID: u64 = unsafe { libc::syscall(libc::SYS_gettid) } as u64;
+    }
+    let tid = TRACE_TID.with(|tid| *tid);
+    let mut clock = std::mem::MaybeUninit::<libc::timespec>::uninit();
+    assert_eq!(
+        unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, clock.as_mut_ptr()) },
+        0
+    );
+    let clock = unsafe { clock.assume_init() };
+    let time = clock.tv_sec as u64 * 1_000_000_000 + clock.tv_nsec as u64;
+    let mut state = trace.state.lock();
+    if state.0.len() < 1_000_000 {
+        state.0.push([event, subject, arg1, arg2, tid, time]);
+    } else {
+        state.1 += 1;
+    }
+}
+
+#[doc(hidden)]
+pub fn flush_point_trace() -> std::io::Result<()> {
+    let Some(Some(trace)) = POINT_TRACE.get() else {
+        return Ok(());
+    };
+    let state = trace.state.lock();
+    let mut output = BufWriter::new(
+        File::options()
+            .write(true)
+            .create_new(true)
+            .open(&trace.path)?,
+    );
+    writeln!(output, "event,subject,arg1,arg2,tid,time_ns")?;
+    for row in &state.0 {
+        writeln!(
+            output,
+            "{},{},{},{},{},{}",
+            row[0], row[1], row[2], row[3], row[4], row[5]
+        )?;
+    }
+    output.flush()?;
+    std::fs::write(
+        trace.path.with_extension("meta.json"),
+        format!("{{\"events\":{},\"dropped\":{}}}\n", state.0.len(), state.1),
+    )?;
+    Ok(())
+}
+
