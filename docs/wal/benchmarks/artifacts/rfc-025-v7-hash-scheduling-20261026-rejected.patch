+fn advance_v7_logical_hash(
+    next_ticket: &mut u64,
+    prefix: &mut WalV7PrefixMetadata,
+    ticket: u64,
+    input: &WalV7AdmittedInput,
+) -> Result<()> {
+    ensure!(
+        ticket == *next_ticket,
+        "v7 logical hash ticket is not contiguous"
+    );
+    ensure!(
+        input.commit_ts > prefix.last_commit_ts,
+        "v7 logical hash commit timestamp does not advance"
+    );
+    prefix.logical_hasher.update(input.logical_batch.as_bytes());
+    prefix.last_commit_ts = input.commit_ts;
+    *next_ticket = next_ticket
+        .checked_add(1)
+        .context("v7 logical hash ticket overflows")?;
+    Ok(())
+}
