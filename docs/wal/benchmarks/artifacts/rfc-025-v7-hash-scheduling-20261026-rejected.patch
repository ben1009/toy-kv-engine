+/// Hash inline when the preceding storage barrier is slow, or when this group
+/// is small. A busy state or deferred predecessor queues the entire group
+/// instead of blocking the packer. The hint never changes hash or ACK ordering.
+fn try_hash_v7_group(inner: &RuntimeInner, batches: &[AdmittedBatch], target: u64) -> Result<bool> {
+    if inner.v7_defer_large_hashes.load(Ordering::Relaxed) {
+        let logical_bytes = batches.iter().try_fold(0usize, |bytes, batch| {
+            bytes.checked_add(batch.v7_input.as_ref()?.logical_batch.as_bytes().len())
+        });
+        if logical_bytes.is_none_or(|bytes| bytes > V7_INLINE_HASH_MAX_BYTES) {
+            return Ok(false);
+        }
+    }
+    let Some(mut state) = inner.v7_hash_state.try_lock() else {
+        return Ok(false);
+    };
+    let state = state
+        .as_mut()
+        .context("v7 packer has no logical hash state")?;
+    if batches
+        .first()
+        .is_none_or(|batch| batch.ticket != state.next_ticket)
+    {
+        return Ok(false);
+    }
+    for batch in batches {
+        advance_v7_logical_hash(
+            &mut state.next_ticket,
+            &mut state.prefix,
+            batch.ticket,
+            batch
+                .v7_input
+                .as_ref()
+                .context("v7 inline hash has no logical input")?,
+        )?;
+    }
+    ensure!(
+        state.next_ticket == target,
+        "v7 inline hash does not reach group endpoint"
+    );
+    publish_v7_logical_hash(inner, state)?;
+    Ok(true)
+}
+
+/// Hash deferred inputs only through completed DATA. The single coordinator
+/// performs this without holding admission or the packer mutex. Inline group
+/// snapshots may already cover this target, or a later submitted group.
+fn hash_v7_written_prefix(inner: &RuntimeInner, target: u64) -> Result<()> {
+    let mut state = inner.v7_hash_state.lock();
+    let state = state
+        .as_mut()
+        .context("v7 coordinator has no logical hash state")?;
+    if state.next_ticket >= target {
+        return Ok(());
+    }
+    {
+        let mut admission = inner.admission.lock();
+        while admission
+            .v7_pending_hash
+            .front()
+            .is_some_and(|batch| batch.ticket < target)
+        {
+            state.pending.push(
+                admission
+                    .v7_pending_hash
+                    .pop_front()
+                    .expect("front hash batch is present"),
+            );
+        }
+    }
+    let WalV7HashState {
+        next_ticket,
+        prefix,
+        pending,
+    } = state;
+    for batch in pending.drain(..) {
+        advance_v7_logical_hash(next_ticket, prefix, batch.ticket, &batch.input)?;
+        // The encoded bytes drop before their reservation pin on each iteration.
+    }
+    ensure!(
+        *next_ticket == target,
+        "v7 coordinator has no logical bytes for written prefix"
+    );
+    publish_v7_logical_hash(inner, state)?;
+    Ok(())
+}
