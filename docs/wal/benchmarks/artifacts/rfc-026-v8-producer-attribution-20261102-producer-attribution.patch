+//! Temporary CPU-only attribution, with real canonical and frame codecs.
+
+use std::{hint::black_box, time::Instant};
+
+use anyhow::{Result, ensure};
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+
+use crate::{
+    pitr::{CanonicalWalEntryStream, LIVE_WAL_V5_LIMITS, RecordedAt, WalBatch, WalEntry},
+    wal::{
+        DirectBuf,
+        v7::codec as v7,
+        v8::{codec as v8, digest},
+    },
+};
+
+#[derive(Serialize)]
+struct Sample {
+    entries: usize,
+    entry_bytes: usize,
+    frame_bytes: usize,
+    round: usize,
+    stage: &'static str,
+    iterations: usize,
+    cpu_ns: u64,
+    wall_ns: u64,
+}
+
+fn frame_v8(logical: &[u8], output: &mut [u8]) -> Result<()> {
+    let count = v8::data_fragment_count(logical.len() as u64).unwrap();
+    for (index, payload) in logical
+        .chunks(v8::WAL_V8_DATA_FRAGMENT_PAYLOAD_CAPACITY)
+        .enumerate()
+    {
+        v8::encode_data_fragment_frame_into(
+            [3; 32],
+            [4; 32],
+            8192 + (index * 4096) as u64,
+            v8::WalV8DataFragmentHeader {
+                segment_ticket: 0,
+                fragment_index: index as u32,
+                fragment_count: count,
+                batch_bytes: logical.len() as u64,
+            },
+            payload,
+            &mut output[index * 4096..(index + 1) * 4096],
+        )?;
+    }
+    Ok(())
+}
+
+pub fn run_if_requested() -> Result<bool> {
+    let Some(path) = std::env::var_os("TOYKV_PREPARATION_MICRO") else {
+        return Ok(false);
+    };
+    let mut samples = Vec::new();
+    let stages = [
+        "copy_without_crc",
+        "encode_entry_crc",
+        "encode_crc_inline_blake3",
+        "blake3_only",
+        "sha256_only",
+        "frame_crc_only",
+        "v7_frame_codec",
+        "v8_frame_codec",
+    ];
+    for entries in [2, 8, 64] {
+        let batch = WalBatch {
+            commit_ts: 1,
+            recorded_at: RecordedAt { secs: 1, nanos: 0 },
+            entries: (0..entries)
+                .map(|i| {
+                    let mut key = vec![0];
+                    key.extend_from_slice(format!("key{i:08}").as_bytes());
+                    WalEntry::Put {
+                        key,
+                        value: vec![b'x'; 1024],
+                    }
+                })
+                .collect(),
+        };
+        let canonical = CanonicalWalEntryStream::new(&batch, LIVE_WAL_V5_LIMITS)?;
+        let len = canonical.data_len();
+        let mut reference = vec![0; len];
+        let (_, crc) = canonical.encode_into(&mut reference)?;
+        ensure!(
+            crc == crc32fast::hash(&reference),
+            "canonical CRC probe mismatch"
+        );
+        let mut output = vec![0; len];
+        canonical.encode_without_crc_probe(&mut output)?;
+        ensure!(
+            output == reference,
+            "copy-only reference changes wire bytes"
+        );
+        let mut hasher = digest::WalV8EntryHasher::new(len as u64);
+        hasher.update(&reference)?;
+        let expected_digest = hasher.finish()?;
+        let mut inline = digest::WalV8EntryHasher::new(len as u64);
+        let (_, observed_crc) =
+            canonical.encode_into_with_observer(&mut output, |range| inline.update(range))?;
+        ensure!(
+            output == reference && observed_crc == crc && inline.finish()? == expected_digest,
+            "inline probe changes canonical bytes, CRC or digest"
+        );
+
+        let encoded_v7 = v7::prepare_logical_batch(&batch, LIVE_WAL_V5_LIMITS)?
+            .encode_entry_stream()?
+            .into_logical_batch(0, 1, batch.recorded_at)?;
+        let header = v8::WalV8LogicalBatchHeader {
+            segment_ticket: 0,
+            commit_ts: 1,
+            recorded_at_secs: 1,
+            recorded_at_nanos: 0,
+            entry_count: canonical.entry_count(),
+        }
+        .encode_with_data_crc(len, crc, LIVE_WAL_V5_LIMITS)?;
+        let mut logical = header.to_vec();
+        logical.extend_from_slice(&reference);
+        ensure!(
+            encoded_v7.as_bytes() == logical,
+            "v7/v8 canonical logical bytes differ"
+        );
+        let frame_bytes = v8::data_fragment_count(logical.len() as u64).unwrap() as usize * 4096;
+        let mut frames = DirectBuf::new(frame_bytes);
+        frame_v8(&logical, frames.as_mut_slice())?;
+        for (index, frame) in frames.as_mut_slice().chunks_exact(4096).enumerate() {
+            v8::decode_frame_structural(frame, 8192 + (index * 4096) as u64, &[3; 32], &[4; 32])?;
+        }
+        let mut v7_frames = DirectBuf::new(frame_bytes);
+        encoded_v7.encode_data_frames_into([3; 32], 8192, 0, v7_frames.as_mut_slice())?;
+
+        // Measure a whole repeated stage with two clock reads, rather than
+        // timing every tiny CRC update. Buffers and canonical indexes are reused.
+        for round in 0..8 {
+            let order: Vec<usize> = if round % 2 == 0 {
+                (0..stages.len()).collect()
+            } else {
+                (0..stages.len()).rev().collect()
+            };
+            for stage in order {
+                let iterations = if round == 0 { 200 } else { 2000 };
+                let cpu_start = digest::thread_cpu_time_ns();
+                let wall_start = Instant::now();
+                for _ in 0..iterations {
+                    match stage {
+                        0 => {
+                            black_box(canonical.encode_without_crc_probe(black_box(&mut output))?);
+                        }
+                        1 => {
+                            black_box(canonical.encode_into(black_box(&mut output))?);
+                        }
+                        2 => {
+                            let mut inline = digest::WalV8EntryHasher::new(len as u64);
+                            black_box(
+                                canonical
+                                    .encode_into_with_observer(black_box(&mut output), |range| {
+                                        inline.update(range)
+                                    })?,
+                            );
+                            black_box(inline.finish()?);
+                        }
+                        3 => {
+                            let mut hash = digest::WalV8EntryHasher::new(len as u64);
+                            hash.update(black_box(&reference))?;
+                            black_box(hash.finish()?);
+                        }
+                        4 => {
+                            black_box(Sha256::digest(black_box(encoded_v7.as_bytes())));
+                        }
+                        5 => {
+                            for frame in black_box(frames.as_mut_slice()).chunks_exact(4096) {
+                                let mut crc = crc32fast::Hasher::new();
+                                crc.update(&frame[..60]);
+                                crc.update(&frame[64..]);
+                                black_box(crc.finalize());
+                            }
+                        }
+                        6 => {
+                            black_box(encoded_v7.encode_data_frames_into(
+                                [3; 32],
+                                8192,
+                                0,
+                                black_box(v7_frames.as_mut_slice()),
+                            )?);
+                        }
+                        7 => {
+                            frame_v8(black_box(&logical), black_box(frames.as_mut_slice()))?;
+                        }
+                        _ => unreachable!(),
+                    }
+                }
+                let cpu_ns = digest::thread_cpu_time_ns().saturating_sub(cpu_start);
+                let wall_ns = wall_start.elapsed().as_nanos() as u64;
+                if round > 0 {
+                    samples.push(Sample {
+                        entries,
+                        entry_bytes: len,
+                        frame_bytes,
+                        round,
+                        stage: stages[stage],
+                        iterations,
+                        cpu_ns,
+                        wall_ns,
+                    });
+                }
+            }
+        }
+    }
+    std::fs::write(
+        path,
+        serde_json::to_vec_pretty(&serde_json::json!({
+            "method": "Seven CPU-only rounds, one warmup, reversed stage order; reusable buffers; real canonical and frame codecs; copy-only diagnostic clone omits CRC only; no SSD or candidate retained",
+            "all_canonical_bytes_crcs_and_entry_digests_validated": true,
+            "samples": samples,
+        }))?,
+    )?;
+    Ok(true)
+}
