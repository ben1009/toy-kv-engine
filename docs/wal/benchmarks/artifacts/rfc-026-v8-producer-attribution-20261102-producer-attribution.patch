+        let prefix = u32::try_from(field.len())
+            .context("v5 field too large")?
+            .to_be_bytes();
+        dst[at..at + prefix.len()].copy_from_slice(&prefix);
+        at += prefix.len();
+        dst[at..at + field.len()].copy_from_slice(field);
+        at += field.len();
+    }
+
+    Ok(at)
+}
