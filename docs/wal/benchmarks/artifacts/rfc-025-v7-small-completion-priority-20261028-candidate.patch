+    #[test]
+    fn small_completion_priority_tracks_mixed_group_retirement() {
+        let drops = Arc::new(AtomicUsize::new(0));
+        let mut core = WorkerCore::new();
+        let threshold = Some(64 * 1024);
+        assert!(!core.should_prioritize_small_completions(threshold));
+        // Aggregate group bytes reach the threshold, but each write is small.
+        core.enqueue(make_group(0..1, 4096, 2, 32 * 1024, &drops))
+            .expect("small group");
+        assert!(core.should_prioritize_small_completions(threshold));
+        assert!(!core.should_prioritize_small_completions(None));
+        let mixed_start = 4096 + 64 * 1024;
+        let mixed = vec![
+            WriteBuffer::new(
+                DropProbe::new(64 * 1024, Arc::clone(&drops)),
+                mixed_start,
+                64 * 1024,
+            ),
+            WriteBuffer::new(
+                DropProbe::new(4096, Arc::clone(&drops)),
+                mixed_start + 64 * 1024,
+                4096,
+            ),
+        ];
+        core.enqueue(WriteGroup::new(1..2, mixed).expect("mixed group"))
+            .expect("enqueue mixed group");
+        // Ready, staged and submitted large writes all disable early retirement.
+        assert!(!core.should_prioritize_small_completions(threshold));
+        let staged = core.stage_writes(4).expect("stage mixed writes");
+        assert!(!core.should_prioritize_small_completions(threshold));
+        for write in &staged {
+            core.mark_submitted(write.request_id)
+                .expect("submit mixed write");
+        }
+        let large = staged
+            .iter()
+            .find(|write| write.write_len == 64 * 1024)
+            .unwrap();
+        let tail = staged
+            .iter()
+            .find(|write| write.file_offset == mixed_start + 64 * 1024)
+            .unwrap();
+        drop(
+            core.complete_write(large.request_id, large.write_len as i32)
+                .expect("complete later large write first"),
+        );
+        // Its terminal metadata remains until the unfinished mixed group retires.
+        assert!(!core.should_prioritize_small_completions(threshold));
+        drop(
+            core.complete_write(tail.request_id, tail.write_len as i32)
+                .expect("complete mixed group"),
+        );
+        assert!(core.should_prioritize_small_completions(threshold));
+        for write in staged
+            .iter()
+            .filter(|write| write.file_offset < mixed_start)
+        {
+            drop(
+                core.complete_write(write.request_id, write.write_len as i32)
+                    .expect("complete earlier small group"),
+            );
+        }
+        assert!(core.is_idle());
+        assert!(!core.should_prioritize_small_completions(threshold));
+        assert_eq!(drops.load(Ordering::Acquire), 4);
