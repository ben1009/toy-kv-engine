+    /// A scheduling hint for small v7 writes, separate from completion safety.
+    /// Keep mixed groups on the ordinary path until the whole group retires,
+    /// including any terminal large request still represented in that group.
+    fn should_prioritize_small_completions(&self, large_write_min_bytes: Option<usize>) -> bool {
+        large_write_min_bytes.is_some_and(|minimum| {
+            !self.writes.is_empty() && self.writes.values().all(|write| write.write_len < minimum)
+        })
+    }
