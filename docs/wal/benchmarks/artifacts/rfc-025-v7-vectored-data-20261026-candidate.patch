+const MAX_VECTORED_WRITE_BUFFERS: usize = 8;
+
+/// The box pins both the iovec array and its original buffer owners. Neither
+/// payload bytes nor their reservation pins are copied or released by gathering.
+struct VectoredWriteBuffers<B> {
+    buffers: [Option<B>; MAX_VECTORED_WRITE_BUFFERS],
+    vectors: [libc::iovec; MAX_VECTORED_WRITE_BUFFERS],
+    count: usize,
+}
+
+impl<B: WorkerBuffer> VectoredWriteBuffers<B> {
+    fn push(&mut self, buffer: B, write_len: usize) {
+        assert!(self.count < MAX_VECTORED_WRITE_BUFFERS);
+        self.vectors[self.count] = libc::iovec {
+            iov_base: buffer.as_ptr().cast_mut().cast(),
+            iov_len: write_len,
+        };
+        self.buffers[self.count] = Some(buffer);
+        self.count += 1;
+    }
+}
+
+enum OwnedWriteBuffer<B> {
+    Single(B),
+    Vectored(Box<VectoredWriteBuffers<B>>),
+}
+
+impl<B: WorkerBuffer> OwnedWriteBuffer<B> {
+    fn append(self, previous_len: usize, buffer: B, write_len: usize) -> Self {
+        let mut gathered = match self {
+            Self::Single(first) => {
+                let mut gathered = Box::new(VectoredWriteBuffers {
+                    buffers: std::array::from_fn(|_| None),
+                    vectors: [libc::iovec {
+                        iov_base: std::ptr::null_mut(),
+                        iov_len: 0,
+                    }; MAX_VECTORED_WRITE_BUFFERS],
+                    count: 0,
+                });
+                gathered.push(first, previous_len);
+                gathered
+            }
+            Self::Vectored(gathered) => gathered,
+        };
+        gathered.push(buffer, write_len);
+        Self::Vectored(gathered)
+    }
+
+    fn as_ptr(&self) -> *const u8 {
+        match self {
+            Self::Single(buffer) => buffer.as_ptr(),
+            Self::Vectored(gathered) => gathered.buffers[0]
+                .as_ref()
+                .expect("vectored write owns its first buffer")
+                .as_ptr(),
+        }
+    }
+
+    fn vectors(&self) -> Option<(*const libc::iovec, u32)> {
+        match self {
+            Self::Single(_) => None,
+            Self::Vectored(gathered) => Some((gathered.vectors.as_ptr(), gathered.count as u32)),
+        }
+    }
+
+    fn retire_into(self, events: &mut Vec<WorkerEvent<B>>) {
+        match self {
+            Self::Single(buffer) => events.push(WorkerEvent::BufferRetired(buffer)),
+            Self::Vectored(mut gathered) => {
+                for buffer in &mut gathered.buffers[..gathered.count] {
+                    events.push(WorkerEvent::BufferRetired(
+                        buffer.take().expect("vectored write owns every segment"),
+                    ));
+                }
+            }
+        }
+    }
+}
