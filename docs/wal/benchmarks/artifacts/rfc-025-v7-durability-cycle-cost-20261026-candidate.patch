@@ -2936,0 +2972,70 @@ mod tests {
+    #[cfg(all(feature = "bench", feature = "chaos-testing"))]
+    #[test]
+    fn failpoint_v7_durability_feedback_includes_frontier_write() -> anyhow::Result<()> {
+        use crate::chaos::failpoint::{self, FailScenario};
+
+        let _scenario = FailScenario::setup();
+        let directory = tempfile::tempdir()?;
+        let path = directory.path().join("v7-cycle-feedback.wal");
+        let Some(V7RuntimeTestWal { wal, owner, .. }) =
+            live_v7_test_wal(&path, super::MAX_WAL_FILE_SIZE, v7_test_resource_limits())?
+        else {
+            return Ok(());
+        };
+        let profile = Arc::new(crate::mem_table::WriteProfile::default());
+        wal.set_write_profile(Arc::clone(&profile));
+        let before = profile.snapshot();
+        let runtime = wal.parallel_runtime.as_ref().unwrap();
+        // Bypass the automatic packer/coordinator so this call's returned
+        // batching signal can be compared with the actual nested I/O timers.
+        let mut packer = runtime.inner.packer_state.lock();
+        wal.put_v7_batch_with_index(&v7_test_batch(1, 16), LIVE_WAL_V5_LIMITS)?;
+        let batch = runtime.inner.admission.lock().queue.pop_front().unwrap();
+        let batch = prepare_test_v7_data(&runtime.inner, &mut packer, batch)?;
+        complete_test_v7_data(&runtime.inner, batch, None)?;
+        failpoint::cfg("parallel_wal.v7_frontier_write_delay", "1*sleep(20)")
+            .expect("valid FRONTIER write delay");
+        let latency =
+            super::synchronize_written_prefix(&runtime.inner.preallocator, &runtime.inner)?
+                .expect("the completed DATA prefix needs a FRONTIER and sync");
+        failpoint::cfg("parallel_wal.v7_frontier_write_delay", "off")
+            .expect("disable FRONTIER write delay");
+
+        let snapshot = profile.snapshot().saturating_sub(before);
+        assert_eq!(snapshot.wal_sync_count, 1);
+        assert_eq!(snapshot.wal_frontier_writes, 1);
+        assert!(snapshot.wal_frontier_write_ns >= 20_000_000);
+        assert_eq!(
+            snapshot.wal_v7_durability_cycle_ns,
+            latency.as_nanos() as u64
+        );
+        assert!(
+            snapshot.wal_v7_durability_cycle_ns
+                >= snapshot.wal_frontier_write_ns + snapshot.wal_fdatasync_ns
+        );
+        assert!(
+            super::synchronize_written_prefix(&runtime.inner.preallocator, &runtime.inner)?
+                .is_none()
+        );
+        let unchanged = profile.snapshot().saturating_sub(before);
+        assert_eq!(
+            unchanged.wal_v7_durability_cycle_ns,
+            snapshot.wal_v7_durability_cycle_ns
+        );
+        assert_eq!(unchanged.wal_sync_count, snapshot.wal_sync_count);
+        runtime.wait_durable(0)?;
+        packer.next_ticket = wal.next_ticket();
+        packer.reserved_end = runtime.logical_length();
+        packer.preallocated_end = std::fs::metadata(&path)?.len();
+        drop(packer);
+        wal.close()?;
+        assert_eq!(owner.snapshot().buffer_memory_bytes, 0);
+
+        profile.reset();
+        let reset = profile.snapshot();
+        assert_eq!(reset.wal_v7_durability_cycle_ns, 0);
+        assert_eq!(reset.wal_v7_durability_cycle_promotions, 0);
+
+        Ok(())
+    }
