+// Temporary Linux-only benchmark experiment. This module is not linked into the
+// engine library and will be removed after preserving the comparison executable.
+mod bench_writer_affinity {
+    use std::{fs, io, path::PathBuf};
+
+    use anyhow::{Context, Result, ensure};
+    use serde::Serialize;
+
+    #[derive(Serialize)]
+    pub struct Placement {
+        writer_index: usize,
+        tid: i32,
+        allowed_cpus: Vec<usize>,
+    }
+
+    #[derive(Serialize)]
+    struct BackgroundPlacement {
+        tid: u32,
+        name: String,
+        allowed_cpus: String,
+    }
+
+    pub struct Capture {
+        path: Option<PathBuf>,
+        mode: String,
+        pin_writers: bool,
+        background_original: Vec<BackgroundPlacement>,
+        background_before: Vec<BackgroundPlacement>,
+        context_before: Option<[i64; 2]>,
+    }
+
+    impl Capture {
+        pub fn new() -> Result<Self> {
+            let path = std::env::var_os("TOYKV_AFFINITY_REPORT").map(PathBuf::from);
+            let mode =
+                std::env::var("TOYKV_AFFINITY_MODE").unwrap_or_else(|_| "writers".to_owned());
+            ensure!(
+                matches!(
+                    mode.as_str(),
+                    "writers" | "io" | "reaper" | "userspace" | "kernel" | "whole"
+                ),
+                "unknown diagnostic affinity mode"
+            );
+            let pin_writers = mode != "whole";
+            ensure!(
+                !pin_writers || path.is_some(),
+                "writer affinity requires an audit path"
+            );
+            let background_original = if path.is_some() {
+                background_snapshot()?
+            } else {
+                Vec::new()
+            };
+            for task in &background_original {
+                let kernel = task.name.starts_with("iou-wrk-");
+                let worker = task.name == "wal-io-worker";
+                let reaper = task.name == "wal-v8-completi";
+                let selected = match mode.as_str() {
+                    "io" => worker,
+                    "reaper" => worker || reaper,
+                    "userspace" | "kernel" => task.tid != std::process::id() && !kernel,
+                    _ => false,
+                };
+                if selected {
+                    pin_thread(task.tid as libc::pid_t)?;
+                }
+            }
+            let background_before = if path.is_some() {
+                background_snapshot()?
+            } else {
+                Vec::new()
+            };
+            Ok(Self {
+                path,
+                mode,
+                pin_writers,
+                background_original,
+                background_before,
+                context_before: None,
+            })
+        }
+
+        pub fn enabled(&self) -> bool {
+            self.path.is_some()
+        }
+
+        pub fn pin_writers(&self) -> bool {
+            self.pin_writers
+        }
+
+        pub fn start_measurement(&mut self) -> Result<()> {
+            if self.enabled() {
+                self.context_before = Some(context_usage()?);
+            }
+            Ok(())
+        }
+
+        pub fn finish(self, writers: Vec<Placement>) -> Result<()> {
+            let Some(path) = self.path else {
+                return Ok(());
+            };
+            let context_after = context_usage()?;
+            let context_before = self
+                .context_before
+                .context("missing starting context usage")?;
+            let background_after = background_snapshot()?;
+            let report = serde_json::json!({
+                "pid": std::process::id(),
+                "mode": self.mode,
+                "pin_writers": self.pin_writers,
+                "writers": writers,
+                "background_original": self.background_original,
+                "background_before": self.background_before,
+                "background_after": background_after,
+                "context": {
+                    "voluntary": context_after[0] - context_before[0],
+                    "involuntary": context_after[1] - context_before[1],
+                },
+            });
+            fs::write(path, serde_json::to_vec_pretty(&report)?)?;
+            Ok(())
+        }
+    }
+
+    pub fn place_writer(writer_index: usize, pin: bool) -> Result<Placement> {
+        if pin {
+            pin_thread(0)?;
+        }
+        // SAFETY: cpu_set_t is a plain integer bitset and zero is an empty mask.
+        let mut mask = unsafe { std::mem::zeroed::<libc::cpu_set_t>() };
+        // SAFETY: mask is a writable CPU_SETSIZE bitset of the supplied size.
+        let result = unsafe {
+            libc::sched_getaffinity(0, std::mem::size_of::<libc::cpu_set_t>(), &mut mask)
+        };
+        ensure!(
+            result == 0,
+            "read writer affinity: {}",
+            io::Error::last_os_error()
+        );
+        let allowed_cpus = (0..libc::CPU_SETSIZE as usize)
+            // SAFETY: every index is bounded by CPU_SETSIZE.
+            .filter(|&cpu| unsafe { libc::CPU_ISSET(cpu, &mask) })
+            .collect();
+        Ok(Placement {
+            writer_index,
+            // SAFETY: gettid takes no arguments and only reports this thread ID.
+            tid: unsafe { libc::gettid() },
+            allowed_cpus,
+        })
+    }
+
+    fn pin_thread(tid: libc::pid_t) -> Result<()> {
+        // SAFETY: cpu_set_t is an integer bitset; selected indices fit CPU_SETSIZE.
+        let mut mask = unsafe { std::mem::zeroed::<libc::cpu_set_t>() };
+        for cpu in 0..16 {
+            // SAFETY: each index is bounded by CPU_SETSIZE.
+            unsafe { libc::CPU_SET(cpu, &mut mask) };
+        }
+        // SAFETY: mask is initialized and its complete size is supplied. A zero
+        // tid selects this writer; other tids were read from /proc/self/task.
+        let result =
+            unsafe { libc::sched_setaffinity(tid, std::mem::size_of::<libc::cpu_set_t>(), &mask) };
+        ensure!(
+            result == 0,
+            "pin diagnostic thread {tid}: {}",
+            io::Error::last_os_error()
+        );
+        Ok(())
+    }
+
+    fn context_usage() -> Result<[i64; 2]> {
+        let mut usage = std::mem::MaybeUninit::<libc::rusage>::uninit();
+        // SAFETY: getrusage initializes the complete output on success.
+        let result = unsafe { libc::getrusage(libc::RUSAGE_SELF, usage.as_mut_ptr()) };
+        ensure!(
+            result == 0,
+            "read context usage: {}",
+            io::Error::last_os_error()
+        );
+        // SAFETY: the successful syscall initialized this structure.
+        let usage = unsafe { usage.assume_init() };
+        Ok([usage.ru_nvcsw, usage.ru_nivcsw])
+    }
+
+    fn background_snapshot() -> Result<Vec<BackgroundPlacement>> {
+        let mut result = Vec::new();
+        for task in fs::read_dir("/proc/self/task")? {
+            let task = task?;
+            let status = match fs::read_to_string(task.path().join("status")) {
+                Ok(status) => status,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => continue,
+                Err(error) => return Err(error.into()),
+            };
+            let field = |name: &str| -> Result<String> {
+                status
+                    .lines()
+                    .find_map(|line| line.strip_prefix(name))
+                    .map(|value| value.trim().to_owned())
+                    .with_context(|| format!("missing thread status field {name}"))
+            };
+            result.push(BackgroundPlacement {
+                tid: task.file_name().to_string_lossy().parse()?,
+                name: field("Name:")?,
+                allowed_cpus: field("Cpus_allowed_list:")?,
+            });
+        }
+        result.sort_by_key(|thread| thread.tid);
+        Ok(result)
+    }
+}
