+// Temporary benchmark-only context-switch attribution, outside the hot path.
+fn wal_context_switches() -> Option<(u64, u64)> {
+    if std::env::var_os("TOYKV_WAL_CONTEXT").is_none() { return None; }
+    let mut usage = std::mem::MaybeUninit::<libc::rusage>::uninit();
+    // SAFETY: getrusage initializes the supplied structure on success.
+    if unsafe { libc::getrusage(libc::RUSAGE_SELF, usage.as_mut_ptr()) } != 0 { return None; }
+    // SAFETY: the successful call initialized usage.
+    let usage = unsafe { usage.assume_init() };
+    Some((usage.ru_nvcsw as u64, usage.ru_nivcsw as u64))
+}
